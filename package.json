{
  "name": "fleekelon",
  "version": "0.2.0",
  "private": true,
  "description": "Personal engineering toolkit: TypeScript CLI, content catalog, profile renderer, and reusable project infrastructure.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@10.9.7",
  "bin": {
    "fleekelon": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts help",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "fleekelon": "tsx src/index.ts",
    "doctor": "tsx src/index.ts doctor",
    "content:list": "tsx src/index.ts content list",
    "content:validate": "tsx src/index.ts content validate",
    "profile:render": "tsx src/index.ts profile render",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run content:validate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/node": "^22.16.5",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
