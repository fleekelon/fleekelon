---
const reviews = [
  {
    rating: '5/5',
    quote: 'I explained a race condition to it for 40 minutes. It said nothing. I fixed it myself. 10/10.',
    name: 'Priya K.',
    title: 'Staff engineer, recovering',
  },
  {
    rating: '5/5',
    quote: 'Finally, a pair programmer that never suggests rewriting everything in Rust.',
    name: 'Jamie R.',
    title: 'AI influencer, ex-Web3 influencer',
  },
  {
    rating: '4.5/5',
    quote: 'My duck? If you want it, I’ll let you have it. Look for it! I left it on a desk somewhere.',
    name: 'Gol D. Roger',
    title: 'Old-school pirate',
  },
  {
    rating: '5/5',
    quote: 'It survived my code review. Nothing survives my code review.',
    name: 'Edan K.',
    title: 'Principal reviewer wannabe',
  },
  {
    rating: '5/5',
    quote: 'I tried the wearable mode. I achieved… attention.',
    name: 'Jules M.',
    title: 'Minimalist',
  },
];
---

<section class="mx-auto max-w-7xl px-6 py-28 md:py-40">
  <p class="eyebrow" data-reveal>ratings &amp; reviews · custom reviews [ 364 ]</p>
  <h2 class="h-section mt-4 max-w-3xl" data-reveal>
    People all around the world love Quack <span class="font-mono text-2xl text-accent align-middle">[ 4.9/5 ]</span>
  </h2>
  <p class="mt-5 max-w-md text-sm text-cream-dim" data-reveal>
    Do not take our word for it. See what people say after living with Quack.
  </p>

  <div class="mt-14 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal-stagger>
    {
      reviews.map((r) => (
        <figure class="card flex flex-col justify-between p-6">
          <div>
            <p class="font-mono text-xs text-accent">[ {r.rating} ]</p>
            <blockquote class="mt-4 text-base leading-relaxed">“{r.quote}”</blockquote>
          </div>
          <figcaption class="mt-6">
            <p class="font-mono text-sm">{r.name}</p>
            <p class="font-mono text-xs text-cream-dim">{r.title}</p>
          </figcaption>
        </figure>
      ))
    }
  </div>
</section>
