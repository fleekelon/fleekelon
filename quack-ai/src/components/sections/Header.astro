---
const links = [
  { href: "#model", label: "模型" },
  { href: "#features", label: "能力" },
  { href: "#benchmarks", label: "跑分" },
  { href: "#lineup", label: "产品线" },
  { href: "#paper", label: "论文" },
];
---

<header class="site-header fixed inset-x-0 top-0 z-50" data-header>
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <a href="#top" class="font-mono text-sm tracking-[0.3em] text-cream"
      >QUACK&nbsp;AI</a
    >
    <nav
      class="hidden gap-8 font-mono text-xs tracking-[0.18em] text-cream-dim md:flex"
    >
      {
        links.map((l) => (
          <a class="transition-colors hover:text-accent" href={l.href}>
            {l.label}
          </a>
        ))
      }
    </nav>
    <a href="#lineup" class="btn-primary !px-5 !py-2.5">立即预订*</a>
  </div>
</header>
