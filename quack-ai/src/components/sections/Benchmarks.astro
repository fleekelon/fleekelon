---
const cards = [
  {
    title: "边缘计算",
    body: "拒绝云端,只做桌面端推理。你的 bug 永远不会离开这个房间。",
  },
  {
    title: "永远在线",
    body: "24/7 全天候待命,无需供电。在任何消费级 GPU 上都不会 OOM——毕竟它不用 GPU。",
  },
  {
    title: "跌落测试",
    body: "测试条件:硬质地板。损伤报告:地板没事,鸭子也没事。",
  },
  {
    title: "祖传兼容",
    body: "向后兼容自浴缸发明以来的所有代码库。",
  },
];
---

<section
  id="benchmarks"
  class="relative mx-auto max-w-7xl px-6 py-28 md:py-40"
>
  <div class="ghost-title absolute -top-4 right-0 opacity-60" aria-hidden="true">
    SOTA
  </div>
  <p class="eyebrow" data-reveal>
    <span class="idx">04</span>BATHBENCH™ · 仅供可视化,不构成质保
  </p>
  <h2 class="h-section mt-4" data-reveal>最先进水平。指漂浮。</h2>

  <div class="mt-14 grid gap-6 md:grid-cols-3" data-reveal-stagger>
    <div class="card p-8 text-center">
      <p class="spec-num">
        <span data-counter="100">0</span><span class="text-3xl">%</span>
      </p>
      <p class="eyebrow mt-4">听 bug 准确率</p>
    </div>
    <div class="card p-8 text-center">
      <p class="spec-num">
        <span data-counter="0.80" data-counter-decimals="2">0</span>
      </p>
      <p class="eyebrow mt-4">摩擦系数(估)</p>
    </div>
    <div class="card p-8 text-center">
      <p class="spec-num">
        <span data-counter="0">0</span><span class="text-3xl">W</span>
      </p>
      <p class="eyebrow mt-4">推理全程功耗</p>
    </div>
  </div>

  <div
    class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4"
    data-reveal-stagger
  >
    {
      cards.map((c) => (
        <article class="card p-6">
          <h3 class="font-mono text-sm tracking-[0.15em] text-accent">
            {c.title}
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-cream-dim">{c.body}</p>
        </article>
      ))
    }
  </div>
</section>
