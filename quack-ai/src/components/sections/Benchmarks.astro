---
const cards = [
  { title: 'Runs on the edge', body: 'Refuses the cloud. On-desk inference only. Your bugs never leave the room.' },
  { title: 'Always on', body: '24/7 uptime. No power required. No OOM on any consumer GPU — or any GPU.' },
  { title: 'Drop-tested', body: 'Test conditions: hard floor. Damage report: the floor is fine. So is the duck.' },
  { title: 'Legacy support', body: 'Backward compatible with every codebase since the invention of the bathtub.' },
];
---

<section id="benchmarks" class="mx-auto max-w-7xl px-6 py-28 md:py-40">
  <p class="eyebrow" data-reveal>bathbench™ · a visualization, not a warranty</p>
  <h2 class="h-section mt-4" data-reveal>State of the art. Of floating.</h2>

  <div class="mt-14 grid gap-6 md:grid-cols-3" data-reveal-stagger>
    <div class="card p-8 text-center">
      <p class="spec-num"><span data-counter="100">0</span><span class="text-3xl">%</span></p>
      <p class="eyebrow mt-4">bug-listening accuracy</p>
    </div>
    <div class="card p-8 text-center">
      <p class="spec-num"><span data-counter="0.80" data-counter-decimals="2">0</span></p>
      <p class="eyebrow mt-4">friction coefficient (est.)</p>
    </div>
    <div class="card p-8 text-center">
      <p class="spec-num"><span data-counter="0">0</span><span class="text-3xl">W</span></p>
      <p class="eyebrow mt-4">power draw while reasoning</p>
    </div>
  </div>

  <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-4" data-reveal-stagger>
    {
      cards.map((c) => (
        <article class="card p-6">
          <h3 class="font-mono text-sm tracking-[0.15em] uppercase text-accent">{c.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-cream-dim">{c.body}</p>
        </article>
      ))
    }
  </div>
</section>
